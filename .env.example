# Copy this file to .env and fill in the values for your environment.
# .env is gitignored; never commit real secrets.

# "demo" = local simulated tokens/funding, no Solana calls.
# "devnet" = real Solana Devnet transactions; requires PostgreSQL below.
APP_MODE='demo'

# sqlite:///.data/loopmint.db for local demo mode.
# postgres://... (Tiger Data / TimescaleDB) is required when APP_MODE=devnet.
DATABASE_URL='sqlite:///.data/loopmint.db'

# Seeded demo accounts (recycler/verifier/partner) usable without a password.
# Must be 'false' outside of local demos.
DEMO_ACCOUNTS_ENABLED='true'

# Runs the Devnet issuance/reconciliation worker loop inside the API process.
# Keep 'true' for local demo; run the worker as a separate process otherwise.
DEMO_AUTO_WORKER='true'

# Origin allowed to make unsafe (non-GET) requests to the API.
PUBLIC_ORIGIN='http://localhost:3000'

# Set 'true' when serving over HTTPS so session cookies require it.
SECURE_COOKIES='false'

# Enables the recycling_events hypertable / continuous aggregate queries.
# Requires TimescaleDB; run `python -m app.cli enable-timescale` first.
TIMESCALE_ENABLED='false'

# Browser-restricted Google Maps key used by the frontend for center search.
GOOGLE_MAPS_BROWSER_KEY=''

SOLANA_RPC_URL='https://api.devnet.solana.com'
# Path to the issuer keypair JSON file (Devnet mode only).
SOLANA_ISSUER_KEYPAIR=''
# Devnet SPL token mint address for LOOP (2 decimals).
SOLANA_MINT=''

# LoopMint Assistant (read-only recycling helper, never approves claims or moves funds).
# Leave empty to disable the assistant: /api/chat answers "not configured" and the
# chat button stays hidden in the frontend. Get a key from https://aistudio.google.com/.
GEMINI_API_KEY=''
# Any Gemini model that supports function calling.
GEMINI_MODEL='gemini-2.0-flash'
