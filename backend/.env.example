# Put this file at the repository root as .env when running scripts/dev.sh.
APP_MODE=demo
DATABASE_URL=sqlite:///.data/loopmint.db
PUBLIC_ORIGIN=http://localhost:3000
SECURE_COOKIES=false
DEMO_AUTO_WORKER=true
TIMESCALE_ENABLED=false
TICKET_TTL_SECONDS=1800

# For actual Devnet issuance use a NEW PostgreSQL database, APP_MODE=devnet,
# and run the separate worker. These values are server-side only.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/loopmint?sslmode=require
SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_MINT=
SOLANA_ISSUER_KEYPAIR=
TOKEN_DECIMALS=2

# Optional: enables the authenticated in-app recycling and LoopMint assistant.
# Create a key in Google AI Studio and keep it server-side in this file.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
