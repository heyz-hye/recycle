# Put this file at the repository root as .env when running scripts/dev.sh.
APP_MODE=demo
DATABASE_URL=sqlite:///.data/loopmint.db
PUBLIC_ORIGIN=http://localhost:3000
SECURE_COOKIES=false
DEMO_AUTO_WORKER=true
DEMO_ACCOUNTS_ENABLED=true
TIMESCALE_ENABLED=false
GOOGLE_MAPS_BROWSER_KEY=
GOOGLE_MAPS_MAP_ID=DEMO_MAP_ID
TICKET_TTL_SECONDS=1800

# For actual Devnet transfers use a NEW PostgreSQL database, APP_MODE=devnet,
# and run the separate worker. These values are server-side only.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/loopmint?sslmode=require
# Tiger Data: copy the service connection URL, including its port and database.
# DATABASE_URL=postgresql://tsdbadmin:URL_ENCODED_PASSWORD@SERVICE_HOST:SERVICE_PORT/tsdb?sslmode=require
# Set DEMO_ACCOUNTS_ENABLED=false for individual accounts without shared demo logins.
SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_MINT=
SOLANA_ISSUER_KEYPAIR=
TOKEN_DECIMALS=2

# LOOP is transferred from this treasury, never minted on withdrawal.
# Fund it with existing LOOP, Devnet SOL for fees, and test USDC for conversions.
SOLANA_USDC_MINT=4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU
TREASURY_FEE_RESERVE_LAMPORTS=10000000
