# Copy to repository-root .env, then replace DATABASE_URL with your Tiger Data service URL.
# This file deliberately contains no live credentials. Do not commit the resulting .env.
DATABASE_URL=postgresql://tsdbadmin:URL_ENCODED_PASSWORD@YOUR_SERVICE_HOST:YOUR_SERVICE_PORT/tsdb?sslmode=require
APP_MODE=demo
DEMO_ACCOUNTS_ENABLED=false
DEMO_AUTO_WORKER=true
PUBLIC_ORIGIN=http://localhost:3000
SECURE_COOKIES=false
TIMESCALE_ENABLED=false
GOOGLE_MAPS_BROWSER_KEY=
GOOGLE_MAPS_MAP_ID=DEMO_MAP_ID
# Tokens remain simulated. For an HTTPS deployment, use its PUBLIC_ORIGIN and SECURE_COOKIES=true.
# Devnet requires a separate database, mint, issuer keypair, and worker; see README.
